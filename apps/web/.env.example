# Copy to apps/web/.env.local and adjust. Never commit the real file.
# Anything prefixed with NEXT_PUBLIC_ is shipped to the browser, so never put secrets here.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Maps browser key. It is visible to every visitor by design, so it must be
# restricted in Google Cloud to your website addresses and to the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional. A Map ID from Google Cloud for custom map styling.
# When empty, Google's demo map ID is used, which is meant for development only.
NEXT_PUBLIC_GOOGLE_MAP_ID=
