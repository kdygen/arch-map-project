# Copy to apps/api/.env and adjust. Never commit the real .env file.

# development | test | production
ENVIRONMENT=development

# Local Docker database. In production use the Supabase session pooler connection string.
DATABASE_URL=postgresql+psycopg://archmap:archmap@localhost:5432/archmap

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Server-side Google key for the Routes API. Keep it restricted to the Routes API.
# It never reaches the browser. Leave blank to run without routing.
GOOGLE_MAPS_SERVER_KEY=

# --- Not used yet. Added in later phases. ---
# ANTHROPIC_API_KEY=
